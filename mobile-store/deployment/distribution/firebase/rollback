#!/bin/bash
# =============================================================================
# Firebase App Distribution: rollback
#
# Firebase App Distribution has no "unpublish": a release stays visible to
# its group until it is deleted by hand in the console. Rolling back therefore
# means distributing the previous release again so it becomes the latest
# build of the group. The binary of PREVIOUS_RELEASE_SEMVER is resolved again
# from the platform (scripts/resolve_release_asset), downloaded with the same
# platform layers into $WORKDIR/rollback/<platform>/ and signed with the
# configured signing layer before being distributed.
#
# Limitation: testers who already installed the rolled-back build keep it;
# the rollback only changes what the group sees as the latest release.
# The previous binary goes through the same checks as a deployment (assets
# bucket, archive layout, signing layer). The service account file written
# by the layer setup is deleted on exit.
#
# Inputs: PREVIOUS_DEPLOYMENT_ID, PREVIOUS_RELEASE_SEMVER, PLATFORMS, CHANNEL,
# SIGNING_LAYER, FIREBASE_* (from the layer setup), RELEASE_SEMVER, DIMENSION,
# APPLICATION_SLUG, DEPLOYMENT_ID, WORKDIR, and what resolve_release_asset
# needs (CONTEXT, ASSET_TYPE).
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEPLOYMENT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
# shellcheck source=mobile-store/deployment/distribution/firebase/distribute
source "$SCRIPT_DIR/distribute"

firebase_remove_credentials_on_exit

if [ -z "${PREVIOUS_DEPLOYMENT_ID:-}" ]; then
	{
		echo "   ❌ No previous finalized deployment to roll back to"
		echo "  💡 Possible causes:"
		echo "    • This is the first deployment of the scope"
		echo "    • Every earlier deployment of the scope failed or was deleted"
		echo "  🔧 How to fix:"
		echo "    • Firebase App Distribution cannot unpublish a release: remove the testers from group '${CHANNEL:-internal}' in the Firebase console if this build must not be installed"
		echo "    • Deploy a known-good release again so it becomes the latest one in the group"
	} >&2
	exit 1
fi

if [ -z "${PREVIOUS_RELEASE_SEMVER:-}" ]; then
	{
		echo "   ❌ The release of the previous deployment $PREVIOUS_DEPLOYMENT_ID is unknown"
		echo "  💡 Possible causes:"
		echo "    • build_context could not read the release of deployment $PREVIOUS_DEPLOYMENT_ID (np release read failed)"
		echo "  🔧 How to fix:"
		echo "    • Retry the rollback; if it keeps failing, deploy the previous release again by hand"
	} >&2
	exit 1
fi

for var in FIREBASE_PROJECT GOOGLE_APPLICATION_CREDENTIALS; do
	if [ -z "${!var:-}" ]; then
		{
			echo "   ❌ $var is not set"
			echo "  💡 Possible causes:"
			echo "    • The distribution/firebase layer setup did not run before the rollback"
			echo "  🔧 How to fix:"
			echo "    • Run the rollback workflow from the start so the Firebase layer is configured first"
		} >&2
		exit 1
	fi
done

if ! [[ "${SIGNING_LAYER:-}" =~ ^[a-z0-9-]+$ ]] || [ ! -f "$DEPLOYMENT_DIR/signing/${SIGNING_LAYER:-}/setup" ]; then
	{
		echo "   ❌ Unknown signing implementation: '${SIGNING_LAYER:-}'"
		echo "  💡 Possible causes:"
		echo "    • build_context did not resolve the signing layer, or the scope configuration names one that does not exist"
		echo "  🔧 How to fix:"
		echo "    • Set signing_layer in the 'Mobile store' scope configuration to an implementation under deployment/signing/"
	} >&2
	exit 1
fi

echo "📝 Rolling back to release $PREVIOUS_RELEASE_SEMVER (deployment $PREVIOUS_DEPLOYMENT_ID) on Firebase App Distribution"
echo "   📋 Firebase cannot unpublish release $RELEASE_SEMVER: the previous build is distributed again to group '$CHANNEL'"

# The platform layers read ASSETS_JSON and write under WORKDIR: point both at
# the previous release while keeping distribution.json in the deployment's dir.
DISTRIBUTION_WORKDIR="$WORKDIR"
previous_assets='{}'
for platform in $PLATFORMS; do
	if ! url=$("$DEPLOYMENT_DIR/scripts/resolve_release_asset" "$PREVIOUS_RELEASE_SEMVER" "$platform"); then
		exit 1
	fi
	echo "   ✅ $platform: $platform-$DIMENSION of release $PREVIOUS_RELEASE_SEMVER -> $url"
	previous_assets=$(echo "$previous_assets" | jq -c --arg platform "$platform" --arg url "$url" '.[$platform] = {url: $url}')
done

export ASSETS_JSON="$previous_assets"
export WORKDIR="$DISTRIBUTION_WORKDIR/rollback"
mkdir -p "$WORKDIR"
unset BINARY_PATH_ANDROID BINARY_PATH_IOS SIGNED_BINARY_PATH_ANDROID SIGNED_BINARY_PATH_IOS

for platform in $PLATFORMS; do
	# shellcheck disable=SC1090
	source "$DEPLOYMENT_DIR/platform/$platform/setup"
done
# shellcheck disable=SC1090
source "$DEPLOYMENT_DIR/signing/$SIGNING_LAYER/setup"

export WORKDIR="$DISTRIBUTION_WORKDIR"
firebase_require_setup || exit 1
firebase_distribution_init "$(jq -nc --arg semver "$PREVIOUS_RELEASE_SEMVER" '{rollback_to: $semver}')" || exit 1

release_notes="$APPLICATION_SLUG rollback to $PREVIOUS_RELEASE_SEMVER ($DIMENSION) deployment $DEPLOYMENT_ID"
firebase_distribute_all "$release_notes" || exit 1

echo "✨ Rolled back to release $PREVIOUS_RELEASE_SEMVER on Firebase App Distribution: $(firebase_distribution_file)"

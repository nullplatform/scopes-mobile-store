#!/bin/bash
# =============================================================================
# Distribution layer: Firebase App Distribution
#
# Validates the firebase section of the 'Mobile store' scope configuration
# (project, credentials_secret and the app id of every platform the scope
# publishes), writes the service account from AWS Secrets Manager to
# $WORKDIR/firebase-sa.json (mode 600) and exports what publish, rollback and
# list_releases use:
#
#   FIREBASE_PROJECT, FIREBASE_APP_ID_ANDROID, FIREBASE_APP_ID_IOS,
#   FIREBASE_CREDENTIALS_SECRET, GOOGLE_APPLICATION_CREDENTIALS
#
# The service account needs the Firebase App Distribution Admin role on the
# project. Sourced by the workflow: returns 1 on failure, never exits.
# =============================================================================

# shellcheck source=mobile-store/deployment/scripts/validators
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../../scripts/validators"

echo "🔍 Validating Firebase App Distribution configuration..."

firebase_config() {
	echo "${SCOPE_CONFIGURATION:-null}" | jq -r "$1 // empty" 2>/dev/null || true
}

firebase_cleanup() {
	unset firebase_missing firebase_platform firebase_platform_upper firebase_app_id firebase_app_id_var
	unset firebase_service_account firebase_client_email firebase_missing_platforms
	unset -f firebase_config firebase_cleanup
}

FIREBASE_PROJECT=$(firebase_config '.firebase.project')
FIREBASE_CREDENTIALS_SECRET=$(firebase_config '.firebase.credentials_secret')
FIREBASE_APP_ID_ANDROID=""
FIREBASE_APP_ID_IOS=""

for firebase_platform in ${PLATFORMS:-}; do
	if ! [[ "$firebase_platform" =~ ^(android|ios)$ ]]; then
		{
			echo "   ❌ Unsupported platform '$firebase_platform': Firebase App Distribution publishes android and ios only"
			echo "  💡 Possible causes:"
			echo "    • PLATFORMS was not produced by build_context"
			echo "  🔧 How to fix:"
			echo "    • Run the deployment workflow from the start so build_context resolves the platforms of the scope"
		} >&2
		firebase_cleanup
		return 1
	fi
done

firebase_missing=""
firebase_missing_platforms=""
if [ -z "$FIREBASE_PROJECT" ]; then
	echo "   ❌ firebase.project is missing"
	firebase_missing="$firebase_missing, firebase.project"
elif ! validate_firebase_project "$FIREBASE_PROJECT"; then
	firebase_cleanup
	return 1
else
	echo "   ✅ firebase_project=$FIREBASE_PROJECT"
fi
if [ -z "$FIREBASE_CREDENTIALS_SECRET" ]; then
	echo "   ❌ firebase.credentials_secret is missing"
	firebase_missing="$firebase_missing, firebase.credentials_secret"
fi

for firebase_platform in ${PLATFORMS:-}; do
	firebase_platform_upper=$(echo "$firebase_platform" | tr '[:lower:]' '[:upper:]')
	firebase_app_id=$(firebase_config ".firebase.app_id_$firebase_platform")
	if [ -z "$firebase_app_id" ]; then
		echo "   ❌ firebase.app_id_$firebase_platform is missing"
		firebase_missing="$firebase_missing, firebase.app_id_$firebase_platform"
		firebase_missing_platforms="$firebase_missing_platforms $firebase_platform"
	elif ! validate_firebase_app_id "$firebase_platform" "$firebase_app_id"; then
		firebase_cleanup
		return 1
	else
		echo "   ✅ firebase_app_id_$firebase_platform=$firebase_app_id"
		export "FIREBASE_APP_ID_$firebase_platform_upper=$firebase_app_id"
	fi
done

if [ -n "$firebase_missing" ]; then
	{
		echo "   ❌ The 'Mobile store' scope configuration is incomplete for Firebase App Distribution: missing ${firebase_missing#, }"
		echo "  💡 Possible causes:"
		if [ -n "$firebase_missing_platforms" ]; then
			echo "    • The scope publishes${firebase_missing_platforms} binaries but the Firebase section has no app for that platform"
		fi
		echo "    • The Firebase section of the scope configuration was never filled in"
		echo "  🔧 How to fix:"
		echo "    • Register the app in the Firebase project '${FIREBASE_PROJECT:-<project>}' and set the missing field(s) in the scope configuration:"
		case "$firebase_missing" in *"firebase.project"*) echo "      • firebase.project (the Firebase project id)" ;; esac
		case "$firebase_missing" in *"firebase.credentials_secret"*) echo "      • firebase.credentials_secret (name of the secret with the service account JSON)" ;; esac
		for firebase_platform in $firebase_missing_platforms; do
			echo "      • firebase.app_id_$firebase_platform (e.g. 1:1234567890:$firebase_platform:abcdef)"
		done
	} >&2
	firebase_cleanup
	return 1
fi

if ! command -v firebase >/dev/null 2>&1; then
	{
		echo "   ❌ The firebase CLI is not available in the worker image"
		echo "  💡 Possible causes:"
		echo "    • The worker image was built without firebase-tools"
		echo "  🔧 How to fix:"
		echo "    • Build the worker image from this repository's Dockerfile (it installs firebase-tools@${FIREBASE_CLI_VERSION:-14.27.0}) and pin it in the agent"
	} >&2
	firebase_cleanup
	return 1
fi

if ! validate_scope_secret_name "$FIREBASE_CREDENTIALS_SECRET" "firebase.credentials_secret" "mobile/firebase-sa"; then
	firebase_cleanup
	return 1
fi

echo "   📡 Reading secret '$FIREBASE_CREDENTIALS_SECRET'"
if ! firebase_service_account=$(aws secretsmanager get-secret-value --secret-id "$FIREBASE_CREDENTIALS_SECRET" \
	--query SecretString --output text --region "${ASSETS_REGION:-us-east-1}" 2>/dev/null); then
	{
		echo "   ❌ Could not read secret '$FIREBASE_CREDENTIALS_SECRET' from the secrets manager"
		echo "  💡 Possible causes:"
		echo "    • The secret does not exist in region ${ASSETS_REGION:-us-east-1}"
		echo "    • The agent role has no secretsmanager:GetSecretValue permission on it"
		echo "  🔧 How to fix:"
		echo "    • Create the secret or grant the agent role read access to it"
	} >&2
	firebase_cleanup
	return 1
fi

firebase_client_email=$(echo "$firebase_service_account" | jq -r '
	select(type == "object" and (.client_email | type == "string") and (.private_key | type == "string"))
	| .client_email' 2>/dev/null || true)
if [ -z "$firebase_client_email" ]; then
	{
		echo "   ❌ Secret '$FIREBASE_CREDENTIALS_SECRET' is not a Google service account JSON"
		echo "  💡 Possible causes:"
		echo "    • The secret holds something other than the JSON key downloaded from the Google Cloud console"
		echo "  🔧 How to fix:"
		echo "    • Store the full JSON key of a service account with the Firebase App Distribution Admin role"
	} >&2
	firebase_cleanup
	return 1
fi

GOOGLE_APPLICATION_CREDENTIALS="$WORKDIR/firebase-sa.json"
(umask 077 && mkdir -p "$WORKDIR")
if ! chmod 700 "$WORKDIR"; then
	{
		echo "   ❌ Could not make the workdir $WORKDIR private (chmod 700)"
		echo "  💡 Possible causes:"
		echo "    • The workdir belongs to another user or lives on a filesystem without permissions"
		echo "  🔧 How to fix:"
		echo "    • Point WORKDIR in values.yaml to a directory the worker user owns"
	} >&2
	firebase_cleanup
	return 1
fi
(umask 077 && printf '%s\n' "$firebase_service_account" > "$GOOGLE_APPLICATION_CREDENTIALS")
echo "   ✅ credentials=$GOOGLE_APPLICATION_CREDENTIALS ($firebase_client_email)"

export FIREBASE_PROJECT FIREBASE_CREDENTIALS_SECRET FIREBASE_APP_ID_ANDROID FIREBASE_APP_ID_IOS GOOGLE_APPLICATION_CREDENTIALS
echo "✨ Firebase App Distribution configured"
firebase_cleanup

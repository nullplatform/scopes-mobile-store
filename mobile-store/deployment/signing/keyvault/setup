#!/bin/bash
# =============================================================================
# Signing layer: keyvault
#
# Signs the android binary with the release keystore stored in AWS Secrets
# Manager under the name in SCOPE_CONFIGURATION.android.keystore_secret. The
# secret is a JSON object:
#
#   {"keystore_base64": "<base64 of the .jks/.p12>", "keystore_password": "...",
#    "key_alias": "...", "key_password": "..."}
#
# The keystore is written next to the binary with mode 600, apksigner signs
# into <binary dir>/app-signed.apk and verifies it, and the layer exports
# SIGNED_BINARY_PATH_ANDROID. Passwords only travel through environment
# variables (apksigner --ks-pass env:) and are never printed.
#
# apksigner belongs to the Android build-tools, which the base worker image
# does not ship: this layer needs a worker image derived from this one with
# the build-tools installed (see the Dockerfile).
#
# iOS signing is not implemented in this phase: the layer fails when the scope
# publishes ios. Sourced by the workflow: returns 1 on failure, never exits.
# =============================================================================

# shellcheck source=mobile-store/deployment/scripts/validators
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../../scripts/validators"

echo "🔍 Signing layer 'keyvault': signing with the keystore stored in the secrets manager"

keyvault_fail_secret_read() {
	{
		echo "   ❌ Could not read secret '$1' from the secrets manager"
		echo "  💡 Possible causes:"
		echo "    • The secret does not exist in region ${ASSETS_REGION:-us-east-1}"
		echo "    • The agent role has no secretsmanager:GetSecretValue permission on it"
		echo "  🔧 How to fix:"
		echo "    • Create the secret or grant the agent role read access to it"
	} >&2
}

keyvault_cleanup() {
	unset keyvault_secret keyvault_secret_json keyvault_keystore_password keyvault_key_password
	unset keyvault_key_alias keyvault_keystore keyvault_signed keyvault_binary_dir keyvault_output
	unset MOBILE_STORE_KEYSTORE_PASSWORD MOBILE_STORE_KEY_PASSWORD
}

case " ${PLATFORMS:-} " in
	*" ios "*)
		{
			echo "   ❌ iOS signing with the keyvault layer is not implemented yet"
			echo "  💡 Possible causes:"
			echo "    • The scope publishes ios binaries and the scope configuration sets signing_layer to keyvault"
			echo "  🔧 How to fix:"
			echo "    • Use the prebuilt signing layer (sign in the CI) for scopes that publish ios until keyvault supports it"
		} >&2
		return 1
		;;
esac

if [ -z "${BINARY_PATH_ANDROID:-}" ]; then
	{
		echo "   ❌ BINARY_PATH_ANDROID is not set"
		echo "  💡 Possible causes:"
		echo "    • The platform/android layer did not run before the signing layer"
		echo "  🔧 How to fix:"
		echo "    • Run the deployment workflow from the start so the android binary is downloaded first"
	} >&2
	return 1
fi

if ! command -v apksigner >/dev/null 2>&1; then
	{
		echo "   ❌ apksigner is not available in the worker image"
		echo "  💡 Possible causes:"
		echo "    • The worker image was built without the Android build-tools"
		echo "  🔧 How to fix:"
		echo "    • Build the worker from an image that adds the Android build-tools (apksigner) and pin it in the agent"
	} >&2
	return 1
fi

keyvault_secret=$(echo "${SCOPE_CONFIGURATION:-null}" | jq -r '.android.keystore_secret // empty' 2>/dev/null || true)
if [ -z "$keyvault_secret" ]; then
	{
		echo "   ❌ android.keystore_secret is not set in the 'Mobile store' scope configuration"
		echo "  💡 Possible causes:"
		echo "    • The scope configuration sets signing_layer to keyvault but the Android section has no keystore secret"
		echo "  🔧 How to fix:"
		echo "    • Set android.keystore_secret to the name of the secret that holds the release keystore"
	} >&2
	keyvault_cleanup
	return 1
fi

if ! validate_scope_secret_name "$keyvault_secret" "android.keystore_secret" "mobile/android-keystore"; then
	keyvault_cleanup
	return 1
fi

echo "   📡 Reading secret '$keyvault_secret'"
if ! keyvault_secret_json=$(aws secretsmanager get-secret-value --secret-id "$keyvault_secret" \
	--query SecretString --output text 2>/dev/null); then
	keyvault_fail_secret_read "$keyvault_secret"
	keyvault_cleanup
	return 1
fi

if ! echo "$keyvault_secret_json" | jq -e '
	type == "object"
	and (.keystore_base64 | type == "string" and length > 0)
	and (.keystore_password | type == "string")
	and (.key_alias | type == "string" and length > 0)
	and (.key_password | type == "string")' >/dev/null 2>&1; then
	{
		echo "   ❌ Secret '$keyvault_secret' is not a keystore secret"
		echo "  💡 Possible causes:"
		echo "    • The secret is not a JSON object with keystore_base64, keystore_password, key_alias and key_password"
		echo "  🔧 How to fix:"
		echo "    • Store the secret as {\"keystore_base64\": \"<base64 of the .jks>\", \"keystore_password\": \"...\", \"key_alias\": \"...\", \"key_password\": \"...\"}"
	} >&2
	keyvault_cleanup
	return 1
fi

keyvault_binary_dir="$(dirname "$BINARY_PATH_ANDROID")"
keyvault_keystore="$WORKDIR/android/keystore.jks"
keyvault_signed="$keyvault_binary_dir/app-signed.apk"
keyvault_key_alias=$(echo "$keyvault_secret_json" | jq -r '.key_alias')
keyvault_keystore_password=$(echo "$keyvault_secret_json" | jq -r '.keystore_password')
keyvault_key_password=$(echo "$keyvault_secret_json" | jq -r '.key_password')

mkdir -p "$WORKDIR/android"
if ! (umask 077 && echo "$keyvault_secret_json" | jq -r '.keystore_base64' | base64 -d > "$keyvault_keystore") 2>/dev/null; then
	{
		echo "   ❌ Secret '$keyvault_secret' is not a keystore secret"
		echo "  💡 Possible causes:"
		echo "    • The keystore_base64 field is not valid base64"
		echo "  🔧 How to fix:"
		echo "    • Store the keystore as base64 -w0 of the .jks file"
	} >&2
	rm -f "$keyvault_keystore"
	keyvault_cleanup
	return 1
fi

echo "   📝 Signing $BINARY_PATH_ANDROID with alias '$keyvault_key_alias'"
if ! keyvault_output=$(MOBILE_STORE_KEYSTORE_PASSWORD="$keyvault_keystore_password" \
	MOBILE_STORE_KEY_PASSWORD="$keyvault_key_password" \
	apksigner sign --ks "$keyvault_keystore" --ks-pass env:MOBILE_STORE_KEYSTORE_PASSWORD \
	--ks-key-alias "$keyvault_key_alias" --key-pass env:MOBILE_STORE_KEY_PASSWORD \
	--out "$keyvault_signed" "$BINARY_PATH_ANDROID" 2>&1); then
	{
		echo "   ❌ apksigner could not sign $BINARY_PATH_ANDROID"
		echo "$keyvault_output" | sed 's/^/      /'
		echo "  💡 Possible causes:"
		echo "    • The keystore password, key alias or key password in secret '$keyvault_secret' is wrong"
		echo "    • The keystore_base64 field is not the base64 of a JKS/PKCS12 keystore"
		echo "  🔧 How to fix:"
		echo "    • Update secret '$keyvault_secret' with the keystore the Android app is released with"
	} >&2
	rm -f "$keyvault_keystore"
	keyvault_cleanup
	return 1
fi

if ! keyvault_output=$(apksigner verify "$keyvault_signed" 2>&1); then
	{
		echo "   ❌ The signature of $keyvault_signed does not verify"
		echo "$keyvault_output" | sed 's/^/      /'
		echo "  💡 Possible causes:"
		echo "    • The input binary was already signed with a different scheme or is corrupted"
		echo "  🔧 How to fix:"
		echo "    • Make the CI upload an unsigned (or debug-signed) APK when the signing layer is keyvault"
	} >&2
	rm -f "$keyvault_keystore"
	keyvault_cleanup
	return 1
fi

rm -f "$keyvault_keystore"
echo "   ✅ android: signed $BINARY_PATH_ANDROID -> $keyvault_signed (alias '$keyvault_key_alias')"
SIGNED_BINARY_PATH_ANDROID="$keyvault_signed"
export SIGNED_BINARY_PATH_ANDROID
keyvault_cleanup

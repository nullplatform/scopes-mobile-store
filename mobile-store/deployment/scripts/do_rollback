#!/bin/bash
# =============================================================================
# Roll back through the distribution layer
#
# Runs deployment/distribution/$DISTRIBUTION_LAYER/rollback (an executable:
# it may exit, and it deletes the layer credentials when it ends) and records
# the $WORKDIR/distribution.json it writes on the deployment as a message with
# code MOBILE_STORE_ROLLBACK, best effort.
#
# Inputs: DISTRIBUTION_LAYER, DEPLOYMENT_ID, WORKDIR, SERVICE_PATH, plus what
# the layer's rollback needs (see distribution/<layer>/rollback). Sourced by
# the workflow (works executed too).
# =============================================================================

# shellcheck source=mobile-store/deployment/scripts/deployment_messages
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/deployment_messages"

mobile_store_do_rollback() {
	local layer="${DISTRIBUTION_LAYER:-}" rollback_script distribution_file summary

	if ! [[ "$layer" =~ ^[a-z0-9-]+$ ]]; then
		{
			echo "   ❌ Invalid distribution implementation name '$layer': only lowercase letters, digits and dashes are allowed"
			echo "  💡 Possible causes:"
			echo "    • build_context did not resolve the distribution layer, or the scope configuration sets it to an unexpected value"
			echo "  🔧 How to fix:"
			echo "    • Set the distribution layer in the 'Mobile store' scope configuration to one of the implementations under deployment/distribution/"
		} >&2
		return 1
	fi

	rollback_script="$SERVICE_PATH/deployment/distribution/$layer/rollback"
	if [ ! -x "$rollback_script" ]; then
		{
			echo "   ❌ The distribution layer '$layer' has no rollback"
			echo "  💡 Possible causes:"
			echo "    • '$layer' is not implemented yet, or its rollback script is missing or not executable"
			echo "    • Expected an executable at: $rollback_script"
			echo "  🔧 How to fix:"
			echo "    • Roll back by hand in the $layer console, or set distribution_layer to an implementation under deployment/distribution/ that has a rollback"
		} >&2
		return 1
	fi

	echo "📝 Rolling back through the '$layer' distribution layer..."
	distribution_file="$WORKDIR/distribution.json"
	rm -f "$distribution_file"
	"$rollback_script" || return 1

	if summary=$(jq -c . "$distribution_file" 2>/dev/null) && [ -n "$summary" ]; then
		if record_deployment_message INFO MOBILE_STORE_ROLLBACK "mobile-store rollback: $summary"; then
			echo "   ✅ Recorded the rollback on deployment $DEPLOYMENT_ID (message MOBILE_STORE_ROLLBACK)"
		else
			echo "   ⚠️ Could not record the rollback on deployment $DEPLOYMENT_ID (np deployment patch failed); the summary stays in $distribution_file"
		fi
	fi
	echo "✨ Rollback complete"
}

mobile_store_do_rollback

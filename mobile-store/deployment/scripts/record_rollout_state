#!/bin/bash
# =============================================================================
# switch_traffic / finalize: record the rollout state on the deployment
#
# ROLLOUT_ACTION (step configuration): switch_traffic or finalize.
#
# Firebase App Distribution has no staged rollout: publish already made the
# release available to the whole group, so there is nothing to change on
# Firebase. The step records the final state on the deployment as a message
# with code MOBILE_STORE_ROLLOUT (same mechanism as do_publish, best effort).
#
# The public stores (app-store, google-play) do have a staged rollout, but
# their distribution layers do not exist yet: the step fails with a clear
# message instead of pretending the traffic moved.
#
# Inputs: ROLLOUT_ACTION, DISTRIBUTION_LAYER, CHANNEL, RELEASE_SEMVER,
# DEPLOYMENT_ID. Sourced by the workflow (works executed too).
# =============================================================================

# shellcheck source=mobile-store/deployment/scripts/deployment_messages
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/deployment_messages"

mobile_store_record_rollout_state() {
	local action="${ROLLOUT_ACTION:-}" layer="${DISTRIBUTION_LAYER:-}" state

	case "$action" in
		switch_traffic | finalize) ;;
		*)
			{
				echo "   ❌ Unknown ROLLOUT_ACTION '$action': expected switch_traffic or finalize"
				echo "  💡 Possible causes:"
				echo "    • The workflow step that runs record_rollout_state sets configuration.ROLLOUT_ACTION to an unexpected value"
				echo "  🔧 How to fix:"
				echo "    • Set ROLLOUT_ACTION to switch_traffic or finalize in the workflow step configuration"
			} >&2
			return 1
			;;
	esac

	echo "🔍 $action on distribution '$layer'"

	case "$layer" in
		firebase)
			if [ "$action" = "switch_traffic" ]; then
				state="Firebase App Distribution has no staged rollout: release ${RELEASE_SEMVER:-} is already available to all of group '${CHANNEL:-}'"
			else
				state="Release ${RELEASE_SEMVER:-} stays the latest build of Firebase group '${CHANNEL:-}'; nothing to change on Firebase"
			fi
			;;
		*)
			{
				echo "   ❌ $action is not supported for distribution '${layer:-(not set)}' yet"
				echo "  💡 Possible causes:"
				echo "    • The ${layer:-(not set)} distribution layer (staged rollout on the store) is not implemented yet"
				echo "  🔧 How to fix:"
				echo "    • Use the firebase distribution layer for this scope until ${layer:-(not set)} is supported"
			} >&2
			return 1
			;;
	esac

	echo "   📋 $state"
	if record_deployment_message INFO MOBILE_STORE_ROLLOUT "mobile-store $action: $state"; then
		echo "   ✅ Recorded the rollout state on deployment ${DEPLOYMENT_ID:-} (message MOBILE_STORE_ROLLOUT)"
	else
		echo "   ⚠️ Could not record the rollout state on deployment ${DEPLOYMENT_ID:-} (np deployment patch failed)"
	fi
}

mobile_store_record_rollout_state

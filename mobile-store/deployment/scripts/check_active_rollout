#!/bin/bash
# =============================================================================
# Refuse to start a blue-green deployment while another one is rolling out
#
# Lists the deployments of the scope (same call as build_context) and fails
# when a deployment other than the current one is still in progress: status
# creating, running or waiting_for_instances, or status_in_scope candidate.
# Two overlapping rollouts would distribute two releases to the same group and
# leave no clear deployment to finalize or roll back.
#
# Fails closed: when the deployments cannot be listed, the deployment is not
# started.
#
# Inputs: SCOPE_ID and DEPLOYMENT_ID (the entrypoint exports them), else
# .scope.id and .deployment.id of CONTEXT. Sourced by the workflow (works
# executed too).
# =============================================================================

mobile_store_check_active_rollout() {
	local scope_id deployment_id listing in_progress

	scope_id="${SCOPE_ID:-$(echo "${CONTEXT:-null}" | jq -r '.scope.id // empty' 2>/dev/null)}"
	deployment_id="${DEPLOYMENT_ID:-$(echo "${CONTEXT:-null}" | jq -r '.deployment.id // empty' 2>/dev/null)}"

	if ! [[ "$scope_id" =~ ^[0-9]+$ ]] || ! [[ "$deployment_id" =~ ^[0-9]+$ ]]; then
		{
			echo "   ❌ Invalid scope id '$scope_id' or deployment id '$deployment_id': both must be integers"
			echo "  💡 Possible causes:"
			echo "    • The context was not produced by the platform"
			echo "  🔧 How to fix:"
			echo "    • Run this step from a workflow executed with np service workflow exec --build-context"
		} >&2
		return 1
	fi

	echo "🔍 Checking that no other rollout is in progress in scope $scope_id..."

	if ! listing=$(np deployment list --scope-id "$scope_id" --all --max-pages 5 --format json 2>/dev/null) ||
		! in_progress=$(echo "$listing" | jq -er --arg current "$deployment_id" '
			(if type == "array" then . elif type == "object" and has("results") then .results else error("unexpected deployment listing") end)
			| map(select((.id | tostring) != $current
				and ((.status | IN("creating", "running", "waiting_for_instances")) or .status_in_scope == "candidate")))
			| sort_by(.created_at // "", .id)
			| last
			| if . == null then "" else (.id | tostring) end
		' 2>/dev/null); then
		{
			echo "   ❌ Could not list the deployments of scope $scope_id to check for a rollout in progress"
			echo "  💡 Possible causes:"
			echo "    • The nullplatform API is unavailable or the agent API key cannot read the deployments of the scope"
			echo "  🔧 How to fix:"
			echo "    • Retry the deployment; if it keeps failing, check the agent API key permissions on the scope"
		} >&2
		return 1
	fi

	if [ -n "$in_progress" ]; then
		{
			echo "   ❌ A rollout is already in progress (deployment $in_progress); finalize or roll it back first"
			echo "  💡 Possible causes:"
			echo "    • Deployment $in_progress of scope $scope_id has not been finalized or rolled back yet"
			echo "  🔧 How to fix:"
			echo "    • Finalize deployment $in_progress (or roll it back) and start this deployment again"
		} >&2
		return 1
	fi

	echo "   ✅ No other rollout in progress in scope $scope_id"
}

mobile_store_check_active_rollout

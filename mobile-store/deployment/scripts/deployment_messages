#!/bin/bash
# =============================================================================
# Deployment messages (sourced).
#
# record_deployment_message <level> <code> <message>
#   Appends a message to deployment $DEPLOYMENT_ID with np deployment patch.
#   PATCH /deployment/{id} only takes status, strategy_data and messages, so
#   messages are where the scope records what it did on the distribution
#   channel. Returns 1 when the patch fails; callers treat it as best effort.
# =============================================================================

record_deployment_message() {
	local level="$1" code="$2" message="$3" body
	body=$(jq -nc --arg level "$level" --arg code "$code" --arg message "$message" --argjson timestamp "$(date +%s)" '{
		messages: [{
			level: $level,
			code: $code,
			message: $message,
			timestamp: $timestamp
		}]
	}') || return 1
	np deployment patch --id "$DEPLOYMENT_ID" --body "$body" --format json >/dev/null 2>&1
}

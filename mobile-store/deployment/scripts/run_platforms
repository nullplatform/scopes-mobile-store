#!/bin/bash
# =============================================================================
# Platform layers
#
# The platform layers have no LAYER_VAR (every platform of the scope runs, not
# one implementation picked by the scope configuration), so layer_executor
# does not fit: this step sources deployment/platform/<platform>/setup for
# every platform in PLATFORMS.
#
# Exports BINARY_PATH_ANDROID and BINARY_PATH_IOS for the signing layer. Both
# are always exported (empty for a platform the scope does not publish), so
# the outputs the workflow declares always exist and a value left by an
# earlier run never leaks into this one.
#
# Inputs: PLATFORMS, ASSETS_JSON, ASSETS_BUCKET, ASSETS_REGION, DIMENSION,
# WORKDIR, SERVICE_PATH. Sourced by the workflow (works executed too).
# =============================================================================

mobile_store_run_platforms() {
	local platform setup

	BINARY_PATH_ANDROID=""
	BINARY_PATH_IOS=""
	export BINARY_PATH_ANDROID BINARY_PATH_IOS

	if [ -z "${PLATFORMS:-}" ]; then
		{
			echo "   ❌ PLATFORMS is not set"
			echo "  💡 Possible causes:"
			echo "    • build_context did not run before the platform layers"
			echo "  🔧 How to fix:"
			echo "    • Run the deployment workflow from the start so build_context resolves the platforms of the scope"
		} >&2
		return 1
	fi

	# Check every platform before downloading anything.
	for platform in $PLATFORMS; do
		setup="$SERVICE_PATH/deployment/platform/$platform/setup"
		if ! [[ "$platform" =~ ^[a-z0-9-]+$ ]] || [ ! -f "$setup" ]; then
			{
				echo "   ❌ Unknown platform '$platform': no layer at $setup"
				echo "  💡 Possible causes:"
				echo "    • PLATFORMS was not produced by build_context"
				echo "  🔧 How to fix:"
				echo "    • Run the deployment workflow from the start; the supported platforms are the directories under deployment/platform/"
			} >&2
			return 1
		fi
	done

	echo "🔍 Preparing the platform binaries ($PLATFORMS)..."
	for platform in $PLATFORMS; do
		# shellcheck disable=SC1090
		source "$SERVICE_PATH/deployment/platform/$platform/setup" || return 1
	done
	echo "✨ Platform binaries ready"
}

mobile_store_run_platforms

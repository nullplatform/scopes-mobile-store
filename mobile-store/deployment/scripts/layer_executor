#!/bin/bash
# =============================================================================
# Layer Executor
#
# Resolves and executes the setup script of a layer implementation. Called from
# the workflows after build_context has exported the layer variables.
#
# Configuration (via workflow step configuration):
#   LAYER_TYPE  - The layer directory (signing, distribution, gate)
#   LAYER_VAR   - The environment variable holding the implementation name
#   LAYER_CHECK - Optional. "true" only validates that the implementation
#                 exists (used by the create/update scope workflows), the
#                 setup script is not executed.
#
# Example workflow step:
#   - name: setup_distribution_layer
#     type: script
#     file: "$SERVICE_PATH/deployment/scripts/layer_executor"
#     configuration:
#       LAYER_TYPE: distribution
#       LAYER_VAR: DISTRIBUTION_LAYER
#
# If DISTRIBUTION_LAYER=firebase, executes: deployment/distribution/firebase/setup
# The setup script is sourced, so every variable it exports stays available to
# the following steps.
# =============================================================================

set -euo pipefail

if [ -z "${LAYER_TYPE:-}" ]; then
	{
		echo "   ❌ LAYER_TYPE is not set"
		echo "  💡 Possible causes:"
		echo "    • The workflow step that runs layer_executor has no configuration.LAYER_TYPE"
		echo "  🔧 How to fix:"
		echo "    • Add LAYER_TYPE (signing, distribution or gate) to the workflow step configuration"
	} >&2
	exit 1
fi

if [ -z "${LAYER_VAR:-}" ]; then
	{
		echo "   ❌ LAYER_VAR is not set"
		echo "  💡 Possible causes:"
		echo "    • The workflow step that runs layer_executor has no configuration.LAYER_VAR"
		echo "  🔧 How to fix:"
		echo "    • Add LAYER_VAR (SIGNING_LAYER, DISTRIBUTION_LAYER or GATE_LAYER) to the workflow step configuration"
	} >&2
	exit 1
fi

# LAYER_VAR is expanded indirectly: it must be a plain variable name.
if ! [[ "$LAYER_VAR" =~ ^[A-Z_][A-Z0-9_]*$ ]]; then
	{
		echo "   ❌ Invalid LAYER_VAR '$LAYER_VAR': must be an environment variable name (uppercase letters, digits and underscores)"
		echo "  💡 Possible causes:"
		echo "    • The workflow step configuration sets LAYER_VAR to something that is not a variable name"
		echo "  🔧 How to fix:"
		echo "    • Set LAYER_VAR to the variable build_context exports for this layer (SIGNING_LAYER, DISTRIBUTION_LAYER or GATE_LAYER)"
	} >&2
	exit 1
fi

# LAYER_TYPE becomes a path segment: keep it to the layer directory names.
if ! [[ "$LAYER_TYPE" =~ ^[a-z_]+$ ]]; then
	{
		echo "   ❌ Invalid layer type '$LAYER_TYPE': only lowercase letters and underscores are allowed"
		echo "  💡 Possible causes:"
		echo "    • The workflow step configuration sets LAYER_TYPE to an unexpected value"
		echo "  🔧 How to fix:"
		echo "    • Use one of the layer directories under deployment/ (signing, distribution, gate)"
	} >&2
	exit 1
fi

layer_value="${!LAYER_VAR:-}"

if [ -z "$layer_value" ]; then
	{
		echo "   ❌ $LAYER_VAR is not set"
		echo ""
		echo "  💡 Possible causes:"
		echo "    • build_context did not resolve the $LAYER_TYPE layer"
		echo "    • The scope configuration is missing the $LAYER_TYPE layer"
		echo ""
		echo "  🔧 How to fix:"
		echo "    • Ensure the 'Mobile store' scope configuration has the $LAYER_TYPE layer configured"
		echo ""
	} >&2
	exit 1
fi

# The implementation name comes from the scope configuration and becomes a
# path segment: validate it before composing the setup path.
if ! [[ "$layer_value" =~ ^[a-z0-9-]+$ ]]; then
	{
		echo "   ❌ Invalid $LAYER_TYPE implementation name '$layer_value': only lowercase letters, digits and dashes are allowed"
		echo "  💡 Possible causes:"
		echo "    • The scope configuration sets the $LAYER_TYPE layer to an unexpected value"
		echo "  🔧 How to fix:"
		echo "    • Set the $LAYER_TYPE layer in the 'Mobile store' scope configuration to one of the implementations under deployment/${LAYER_TYPE}/"
	} >&2
	exit 1
fi

setup_script="$SERVICE_PATH/deployment/${LAYER_TYPE}/${layer_value}/setup"

if [ ! -f "$setup_script" ]; then
	{
		echo "   ❌ Unknown $LAYER_TYPE implementation: '$layer_value'"
		echo ""
		echo "  💡 Possible causes:"
		echo "    • '$layer_value' is not a supported $LAYER_TYPE"
		echo "    • The setup script does not exist at: $setup_script"
		echo ""
		echo "  🔧 How to fix:"
		echo "    • Check the available ${LAYER_TYPE} implementations in deployment/${LAYER_TYPE}/"
		echo ""
	} >&2
	exit 1
fi

if [ "${LAYER_CHECK:-false}" = "true" ]; then
	echo "   ✅ $LAYER_TYPE implementation '$layer_value' is available"
else
	echo "📝 Running $LAYER_TYPE layer '$layer_value'"
	# shellcheck disable=SC1090
	source "$setup_script"
fi

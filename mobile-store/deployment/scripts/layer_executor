#!/bin/bash
# =============================================================================
# Layer Executor
#
# Resolves and executes the setup script of a layer implementation. Called from
# the workflows after build_context has exported the layer variables.
#
# Configuration (via workflow step configuration):
#   LAYER_TYPE  - The layer directory (signing, distribution, gate)
#   LAYER_VAR   - The environment variable holding the implementation name
#   LAYER_CHECK - Optional. "true" only validates that the implementation
#                 exists (used by the create/update scope workflows), the
#                 setup script is not executed.
#
# Example workflow step:
#   - name: setup_distribution_layer
#     type: script
#     file: "$SERVICE_PATH/deployment/scripts/layer_executor"
#     configuration:
#       LAYER_TYPE: distribution
#       LAYER_VAR: DISTRIBUTION_LAYER
#
# If DISTRIBUTION_LAYER=firebase, executes: deployment/distribution/firebase/setup
# The setup script is sourced, so every variable it exports stays available to
# the following steps.
# =============================================================================

set -euo pipefail

if [ -z "${LAYER_TYPE:-}" ]; then
	echo "   ❌ LAYER_TYPE is not set" >&2
	echo "  🔧 How to fix: add LAYER_TYPE to the workflow step configuration" >&2
	exit 1
fi

if [ -z "${LAYER_VAR:-}" ]; then
	echo "   ❌ LAYER_VAR is not set" >&2
	echo "  🔧 How to fix: add LAYER_VAR to the workflow step configuration" >&2
	exit 1
fi

layer_value="${!LAYER_VAR:-}"

if [ -z "$layer_value" ]; then
	{
		echo "   ❌ $LAYER_VAR is not set"
		echo ""
		echo "  💡 Possible causes:"
		echo "    • build_context did not resolve the $LAYER_TYPE layer"
		echo "    • The scope configuration is missing the $LAYER_TYPE layer"
		echo ""
		echo "  🔧 How to fix:"
		echo "    • Ensure the 'Mobile store' scope configuration has the $LAYER_TYPE layer configured"
		echo ""
	} >&2
	exit 1
fi

setup_script="$SERVICE_PATH/deployment/${LAYER_TYPE}/${layer_value}/setup"

if [ ! -f "$setup_script" ]; then
	{
		echo "   ❌ Unknown $LAYER_TYPE implementation: '$layer_value'"
		echo ""
		echo "  💡 Possible causes:"
		echo "    • '$layer_value' is not a supported $LAYER_TYPE"
		echo "    • The setup script does not exist at: $setup_script"
		echo ""
		echo "  🔧 How to fix:"
		echo "    • Check the available ${LAYER_TYPE} implementations in deployment/${LAYER_TYPE}/"
		echo ""
	} >&2
	exit 1
fi

if [ "${LAYER_CHECK:-false}" = "true" ]; then
	echo "   ✅ $LAYER_TYPE implementation '$layer_value' is available"
else
	echo "📝 Running $LAYER_TYPE layer '$layer_value'"
	# shellcheck disable=SC1090
	source "$setup_script"
fi

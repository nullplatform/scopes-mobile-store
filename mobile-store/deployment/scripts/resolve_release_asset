#!/bin/bash
# =============================================================================
# Resolve the binary of a release
#
# Usage: resolve_release_asset <semver> <platform>
#
# Prints the url of the asset of type ASSET_TYPE (default bundle) that is the
# <platform> binary of the release with that semver of the application in
# CONTEXT (.application.id, or APPLICATION_ID). Used by the rollback of the
# distribution layers to find the previous binary again.
#
# The asset name follows the same rule as build_context (scripts/asset_names):
# ASSET_NAME (exported by build_context, else resolved from the scope) is the
# asset of the first platform of PLATFORMS; the other platform swaps the prefix.
#
# Looks the release up with np release list and its assets with np asset
# list, like build_context does for the current release.
# =============================================================================

set -euo pipefail

# shellcheck source=mobile-store/deployment/scripts/asset_names
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/asset_names"

semver="${1:-}"
platform="${2:-}"

if [ -z "$semver" ] || [ -z "$platform" ]; then
	echo "   ❌ Usage: resolve_release_asset <semver> <platform>" >&2
	exit 1
fi

if ! [[ "$platform" =~ ^[a-z0-9-]+$ ]]; then
	echo "   ❌ Invalid platform '$platform': only lowercase letters, digits and dashes are allowed" >&2
	exit 1
fi

application_id="${APPLICATION_ID:-}"
if [ -z "$application_id" ] && [ -n "${CONTEXT:-}" ]; then
	application_id=$(echo "$CONTEXT" | jq -r '.application.id // empty' 2>/dev/null || true)
fi
if [ -z "$application_id" ]; then
	{
		echo "   ❌ The application id is unknown (neither APPLICATION_ID nor CONTEXT.application.id is set)"
		echo "  🔧 How to fix:"
		echo "    • Run this script from a workflow executed with np service workflow exec --build-context"
	} >&2
	exit 1
fi

asset_type="${ASSET_TYPE:-bundle}"
primary_platform="${PLATFORMS:-$platform}"
primary_platform="${primary_platform%% *}"
if [ -n "${ASSET_NAME:-}" ]; then
	asset_name="$ASSET_NAME"
	validate_asset_name "$asset_name" "$primary_platform" || exit 1
else
	resolve_scope_asset_name "$primary_platform" || exit 1
	asset_name="$RESOLVED_ASSET_NAME"
fi
expected_name=$(platform_asset_name "$asset_name" "$primary_platform" "$platform") || exit 1

if ! releases=$(np release list --application-id "$application_id" --limit 200 --format json 2>/dev/null); then
	echo "   ❌ Could not list the releases of application $application_id (np release list failed)" >&2
	exit 1
fi

build_id=$(echo "$releases" | jq -r --arg semver "$semver" '
	(if type == "array" then . elif type == "object" and has("results") then .results else [] end)
	| map(select(.semver == $semver)) | first | .build_id // empty' 2>/dev/null || true)
if [ -z "$build_id" ]; then
	{
		echo "   ❌ No release $semver in application $application_id"
		echo "  💡 Possible causes:"
		echo "    • The release was deleted, or it belongs to another application"
		echo "  🔧 How to fix:"
		echo "    • Check the releases of the application: np release list --application-id $application_id"
	} >&2
	exit 1
fi

if ! assets=$(np asset list --build-id "$build_id" --format json 2>/dev/null); then
	echo "   ❌ Could not list the assets of build $build_id of release $semver (np asset list failed)" >&2
	exit 1
fi

url=$(echo "$assets" | jq -r --arg name "$expected_name" --arg type "$asset_type" --arg build "$build_id" '
	(if type == "array" then . elif type == "object" and has("results") then .results else [] end)
	| map(select(.name == $name and .type == $type and ((.build_id // $build) | tostring) == $build)) | first | .url // empty' 2>/dev/null || true)
if [ -z "$url" ]; then
	{
		echo "   ❌ No asset named '$expected_name' of type '$asset_type' in release $semver"
		echo "  💡 Possible causes:"
		echo "    • The CI of release $semver did not register an asset named '$expected_name'"
		echo "    • The scope's asset name changed after release $semver was built"
		echo "  🔧 How to fix:"
		echo "    • Roll back by deploying another release that carries an '$expected_name' asset"
	} >&2
	exit 1
fi

echo "$url"

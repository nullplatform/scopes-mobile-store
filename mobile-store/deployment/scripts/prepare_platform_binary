#!/bin/bash
# =============================================================================
# Shared by the platform layers (deployment/platform/<platform>/setup).
#
# prepare_platform_binary <platform> <extension> <package description> <entry regex> <ci hint>
#
# Downloads the asset of the platform from ASSETS_JSON into
# $WORKDIR/<platform>/app.<extension>, checks that the archive carries an
# entry matching <entry regex> (what makes it an APK or an IPA) and prints
# the path. Returns 1 with the troubleshooting block on any failure; the
# caller (a sourced setup) must `return 1`, never exit.
#
# Inputs: PLATFORMS, ASSETS_JSON, ASSETS_REGION, DIMENSION, WORKDIR.
# =============================================================================

# shellcheck source=mobile-store/deployment/scripts/validators
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/validators"

prepare_platform_binary() {
	local platform="$1" extension="$2" description="$3" entry_regex="$4" ci_hint="$5"
	local scripts_dir url bucket destination extension_upper

	scripts_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

	echo "🔍 Preparing the $platform binary..."

	case " ${PLATFORMS:-} " in
		*" $platform "*) ;;
		*)
			echo "   📋 $platform is not one of the platforms of this scope (${PLATFORMS:-}); nothing to do"
			return 0
			;;
	esac

	url=$(echo "${ASSETS_JSON:-null}" | jq -r --arg platform "$platform" '.[$platform].url // empty' 2>/dev/null || true)
	if [ -z "$url" ]; then
		{
			echo "   ❌ ASSETS_JSON has no url for $platform"
			echo "  💡 Possible causes:"
			echo "    • build_context did not run, or it resolved the assets of another platform"
			echo "  🔧 How to fix:"
			echo "    • Run the deployment workflow from the start so build_context resolves the $platform asset"
		} >&2
		return 1
	fi

	case "$url" in
		s3://* | https://*) ;;
		*)
			{
				echo "   ❌ Unsupported asset url '$url': only s3:// and https:// are supported"
				echo "  💡 Possible causes:"
				echo "    • The CI registered the asset with a url the scope cannot download"
				echo "  🔧 How to fix:"
				echo "    • Make the CI upload the binary to the assets bucket and register its s3:// url"
			} >&2
			return 1
			;;
	esac
	validate_asset_url "$url" || return 1

	destination="$WORKDIR/$platform/app.$extension"
	echo "   📡 Downloading $url to $destination"
	if ! "$scripts_dir/download_asset" "$url" "$destination"; then
		bucket="${url#s3://}"
		bucket="${bucket%%/*}"
		{
			echo "   ❌ Could not download the $platform binary from $url"
			echo "  💡 Possible causes:"
			echo "    • The agent role has no s3:GetObject permission on bucket '$bucket'"
			echo "    • The asset was deleted from the bucket after the build"
			echo "  🔧 How to fix:"
			echo "    • Grant the agent role read access to s3://$bucket"
			echo "    • Rebuild the release so the CI uploads the asset again"
		} >&2
		return 1
	fi

	extension_upper=$(echo "$extension" | tr '[:lower:]' '[:upper:]')
	if ! unzip -l "$destination" 2>/dev/null | grep -Eq "$entry_regex"; then
		{
			echo "   ❌ $destination is not $description inside the archive"
			echo "  💡 Possible causes:"
			echo "    • The CI registered a file that is not an $extension_upper as the '$platform-${DIMENSION:-default}' asset"
			echo "    • The download was truncated"
			echo "  🔧 How to fix:"
			echo "    • Make the CI upload the $extension_upper produced by $ci_hint as the '$platform-${DIMENSION:-default}' asset"
		} >&2
		return 1
	fi

	# Read by the caller after the function returns (functions cannot export to a sourced setup otherwise).
	# shellcheck disable=SC2034
	PREPARED_BINARY_PATH="$destination"
	return 0
}

#!/bin/bash
# =============================================================================
# Publish the release through the distribution layer
#
# Runs deployment/distribution/$DISTRIBUTION_LAYER/publish (which must write
# {provider, releases} to $WORKDIR/distribution.json), completes the summary
# with the channel and rollout percentage, and records it on the deployment.
#
# Where the summary lives: PATCH /deployment/{id} only takes status,
# strategy_data and messages (np deployment patch --help; the API schema has
# no metadata field, and np metadata create needs a metadata specification
# registered for the deployment entity, which the scope does not own). The
# summary is therefore recorded as a deployment message with code
# MOBILE_STORE_DISTRIBUTION, best effort: when the patch fails the file in
# WORKDIR is still the source of truth and the publish is not failed, since
# the binary is already distributed.
#
# When the publish fails after distributing part of the platforms
# (distribution.json with "partial": true), an ERROR message with code
# MOBILE_STORE_DISTRIBUTION_PARTIAL is recorded the same way, best effort.
#
# Before publishing, the gate policy is enforced (validate_gate_for_channel):
# production on a public store without the store-review gate is refused, and
# any gate other than none must have exported GATE_RESULT=approved.
#
# Inputs: DISTRIBUTION_LAYER, GATE_LAYER, GATE_RESULT, DEPLOYMENT_ID, CHANNEL, ROLLOUT_PERCENTAGE,
# WORKDIR, SERVICE_PATH, plus what the publish script needs.
# =============================================================================

set -euo pipefail

# shellcheck source=mobile-store/deployment/scripts/validators
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/validators"
# shellcheck source=mobile-store/deployment/scripts/deployment_messages
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/deployment_messages"

# If anything fails in this step before the layer's publish deletes them, the
# credentials the distribution setup wrote must not stay in WORKDIR.
if [ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ] && [ "$GOOGLE_APPLICATION_CREDENTIALS" = "${WORKDIR:-}/firebase-sa.json" ]; then
	MOBILE_STORE_FIREBASE_CREDENTIALS="$GOOGLE_APPLICATION_CREDENTIALS"
	trap 'rm -f "${MOBILE_STORE_FIREBASE_CREDENTIALS:-}"' EXIT
fi

layer="${DISTRIBUTION_LAYER:-}"
if [ -z "$layer" ]; then
	{
		echo "   ❌ DISTRIBUTION_LAYER is not set"
		echo "  💡 Possible causes:"
		echo "    • build_context did not resolve the distribution layer"
		echo "  🔧 How to fix:"
		echo "    • Ensure the 'Mobile store' scope configuration has the distribution layer configured"
	} >&2
	exit 1
fi

if ! [[ "$layer" =~ ^[a-z0-9-]+$ ]]; then
	{
		echo "   ❌ Invalid distribution implementation name '$layer': only lowercase letters, digits and dashes are allowed"
		echo "  💡 Possible causes:"
		echo "    • The scope configuration sets the distribution layer to an unexpected value"
		echo "  🔧 How to fix:"
		echo "    • Set the distribution layer in the 'Mobile store' scope configuration to one of the implementations under deployment/distribution/"
	} >&2
	exit 1
fi

publish_script="$SERVICE_PATH/deployment/distribution/$layer/publish"
if [ ! -f "$publish_script" ]; then
	{
		echo "   ❌ The distribution layer '$layer' has no publish script"
		echo "  💡 Possible causes:"
		echo "    • '$layer' is not implemented yet, or the scope configuration names a distribution layer that does not exist"
		echo "    • The publish script does not exist at: $publish_script"
		echo "  🔧 How to fix:"
		echo "    • Set distribution_layer in the 'Mobile store' scope configuration to an implementation under deployment/distribution/ that has a publish script"
	} >&2
	exit 1
fi

# Enforced here too: the binary must not reach a public store in production
# without the approval gate, whatever the order of the workflow steps.
validate_gate_for_channel || exit 1
if [ "${GATE_LAYER:-}" != "none" ] && [ "${GATE_RESULT:-}" != "approved" ]; then
	{
		echo "   ❌ The '${GATE_LAYER:-(not set)}' gate has not approved this deployment (GATE_RESULT=${GATE_RESULT:-(not set)})"
		echo "  💡 Possible causes:"
		echo "    • The gate layer did not run before the publish, or the approval is still pending or was rejected"
		echo "  🔧 How to fix:"
		echo "    • Run the deployment workflow from the start so the gate layer runs and approves before publishing"
	} >&2
	exit 1
fi

echo "📝 Publishing through the '$layer' distribution layer..."
distribution_file="$WORKDIR/distribution.json"
rm -f "$distribution_file"
if ! bash "$publish_script"; then
	# A layer that distributed some platforms before failing keeps
	# distribution.json with "partial": true. Those releases cannot be taken
	# back, so leave a trace on the deployment (best effort).
	if [ -f "$distribution_file" ] && jq -e '.partial == true' "$distribution_file" >/dev/null 2>&1; then
		partial_summary=$(jq -c . "$distribution_file")
		if record_deployment_message ERROR MOBILE_STORE_DISTRIBUTION_PARTIAL \
			"mobile-store partial distribution (the releases below stay distributed): $partial_summary"; then
			echo "   ⚠️ Recorded the partial distribution on deployment $DEPLOYMENT_ID (message MOBILE_STORE_DISTRIBUTION_PARTIAL)"
		else
			echo "   ⚠️ Could not record the partial distribution on deployment $DEPLOYMENT_ID (np deployment patch failed); see $distribution_file"
		fi
	fi
	exit 1
fi

if [ ! -f "$distribution_file" ] || ! jq -e 'type == "object" and has("provider") and has("releases")' "$distribution_file" >/dev/null 2>&1; then
	{
		echo "   ❌ The '$layer' publish script did not write $distribution_file"
		echo "  💡 Possible causes:"
		echo "    • The distribution layer does not follow the publish contract (write {provider, releases} to \$WORKDIR/distribution.json)"
		echo "  🔧 How to fix:"
		echo "    • Fix deployment/distribution/$layer/publish so it records the releases it created"
	} >&2
	exit 1
fi

# A layer without staged rollout (Firebase) reports the effective 100%.
summary=$(jq -c --arg channel "${CHANNEL:-internal}" --argjson rollout "${ROLLOUT_PERCENTAGE:-100}" \
	'. + {channel: $channel, rollout_percentage: (.rollout_percentage // $rollout)}' "$distribution_file")
printf '%s\n' "$summary" > "$distribution_file"
echo "   📋 Distribution summary: $summary"

if record_deployment_message INFO MOBILE_STORE_DISTRIBUTION "mobile-store distribution: $summary"; then
	echo "   ✅ Recorded the distribution on deployment $DEPLOYMENT_ID (message MOBILE_STORE_DISTRIBUTION)"
else
	echo "   ⚠️ Could not record the distribution on deployment $DEPLOYMENT_ID (np deployment patch failed); the summary stays in $distribution_file"
fi

echo "✨ Publish complete"

#!/bin/bash
# =============================================================================
# Platform layer: android
#
# Downloads the android asset of the release into $WORKDIR/android/app.apk,
# checks it is an Android package and exports BINARY_PATH_ANDROID for the
# signing layer. Does nothing when the scope does not publish android.
#
# Sourced by the workflow: returns 1 on failure, never exits.
# =============================================================================

# shellcheck source=mobile-store/deployment/scripts/prepare_platform_binary
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../../scripts/prepare_platform_binary"

PREPARED_BINARY_PATH=""
prepare_platform_binary android apk "an Android package: no AndroidManifest.xml" '(^|[[:space:]])AndroidManifest\.xml$' "the Android build" || return 1

if [ -n "$PREPARED_BINARY_PATH" ]; then
	BINARY_PATH_ANDROID="$PREPARED_BINARY_PATH"
	export BINARY_PATH_ANDROID
	echo "   ✅ BINARY_PATH_ANDROID=$BINARY_PATH_ANDROID"
fi
unset PREPARED_BINARY_PATH

#!/bin/bash
# Sourceable helper — do NOT execute directly.
# Reads MOBILE_STORE_ASSUME_ROLE_ARN from the environment. If set, calls
# sts:AssumeRole and exports temporary credentials so all subsequent AWS calls
# (the layers read secrets and assets with them) use that role. If empty or `none`, does nothing — the
# credentials already in the environment (the agent's IRSA, or a developer's
# exported keys on a local run) are used as is.
#
# Requires: aws CLI, jq.
# Expects:  MOBILE_STORE_ASSUME_ROLE_ARN (set by utils/assume_role_step),
#           SCOPE_ID (optional, used for the session name).

if [ -n "${MOBILE_STORE_ASSUME_ROLE_ARN:-}" ] && [ "$MOBILE_STORE_ASSUME_ROLE_ARN" != "none" ]; then
  echo "   🔑 Assuming role: $MOBILE_STORE_ASSUME_ROLE_ARN"

  _ar_sts_error=$(mktemp)
  if ! ASSUMED_CREDS=$(aws sts assume-role \
    --role-arn "$MOBILE_STORE_ASSUME_ROLE_ARN" \
    --role-session-name "np-mobile-store-${SCOPE_ID:-workflow}" \
    --output json 2>"$_ar_sts_error"); then
    echo "   ❌ sts:AssumeRole failed for $MOBILE_STORE_ASSUME_ROLE_ARN" >&2
    cat "$_ar_sts_error" >&2
    rm -f "$_ar_sts_error"
    return 1
  fi
  rm -f "$_ar_sts_error"

  _ar_access_key=$(echo "$ASSUMED_CREDS"    | jq -r '.Credentials.AccessKeyId // ""')
  _ar_secret_key=$(echo "$ASSUMED_CREDS"    | jq -r '.Credentials.SecretAccessKey // ""')
  _ar_session_token=$(echo "$ASSUMED_CREDS" | jq -r '.Credentials.SessionToken // ""')

  if [ -z "$_ar_access_key" ] || [ -z "$_ar_secret_key" ] || [ -z "$_ar_session_token" ]; then
    echo "   ❌ sts:AssumeRole returned incomplete credentials for $MOBILE_STORE_ASSUME_ROLE_ARN" >&2
    return 1
  fi

  export AWS_ACCESS_KEY_ID="$_ar_access_key"
  export AWS_SECRET_ACCESS_KEY="$_ar_secret_key"
  export AWS_SESSION_TOKEN="$_ar_session_token"

  echo "   ✅ Role assumed successfully"
else
  echo "   ✅ assume_role=skipped (using agent credentials)"
fi
